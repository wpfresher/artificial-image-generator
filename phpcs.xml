<?xml version="1.0"?>
<ruleset name="WpFresher Coding Standards">
    <description>WpFresher PHPCS extended.</description>

    <!-- Check all PHP files in directory tree by default. -->
    <file>.</file>
    <exclude-pattern>languages/</exclude-pattern>
    <exclude-pattern>assets/</exclude-pattern>
    <exclude-pattern>dist/</exclude-pattern>
    <exclude-pattern>bin/</exclude-pattern>
    <exclude-pattern>tests/legacy/</exclude-pattern>
    <exclude-pattern>.github/</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*\.(css|js|xml)</exclude-pattern>
    <arg name="basepath" value="./"/><!-- Strip the file paths down to the relevant bit -->
    <arg name="extensions" value="php"/>

    <!-- Rules -->
    <rule ref="WpFresher-Default"/>

    <!-- Test method names describe the test; docblocks would only repeat them. -->
    <rule ref="Squiz.Commenting.FunctionComment.Missing">
        <exclude-pattern>tests/</exclude-pattern>
    </rule>
    <rule ref="Generic.Commenting.DocComment.MissingShort">
        <exclude-pattern>tests/</exclude-pattern>
    </rule>

    <!-- Check that the proper text domain(s) is used everywhere. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="artificial-image-generator"/>
            </property>
        </properties>
    </rule>

</ruleset>
